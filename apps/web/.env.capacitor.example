# A bundled Android build cannot use Vite's relative /api proxy.
# Set this to the HTTPS URL of the deployed Django API, including /api.
VITE_API_BASE_URL=https://api.example.com/api

# Optional local development alternative. Set CAPACITOR_SERVER_URL to the
# Vite dev server URL when using `cap run android` against a LAN dev server.
# CAPACITOR_SERVER_URL=https://192.168.1.10:5173
# CAPACITOR_ALLOW_CLEARTEXT=false
