# ============================================================
# E-Boses Monorepo — .gitignore
# ============================================================

# --------------------------------------------------
# Python / Django
# --------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
*.whl
*.egg-info/
*.manifest
*.spec
*.so
env/
venv/
.venv/
virtualenv/
*.env
*.venv

# Django
*.log
local_settings.py
db.sqlite3
media/
staticfiles/
static_root/
media_root/

# --------------------------------------------------
# Node / Vite / TypeScript
# --------------------------------------------------
node_modules/
.pnp
.pnp.js
dist/
build/
*.tsbuildinfo
.next/
.cache/
*.tgz
.yarn/*
!.yarn/releases
!.yarn/plugins
!.yarn/versions

# Vite
*.local
apps/web/dist/

# --------------------------------------------------
# IDE / Editor
# --------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace
*.code-workspace
.history/

# --------------------------------------------------
# OS files
# --------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --------------------------------------------------
# Environment files
# --------------------------------------------------
.env
.env.local
.env.development.local
.env.production.local
.env.staging.local
apps/web/.env
apps/web/.env.local
apps/api/.env

# --------------------------------------------------
# Docker
# --------------------------------------------------
docker-compose.override.yml

# --------------------------------------------------
# Logs
# --------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --------------------------------------------------
# Caches
# --------------------------------------------------
.eslintcache
.stylelintcache
*.tsbuildinfo

# --------------------------------------------------
# Testing / Coverage
# --------------------------------------------------
coverage/
.coverage
htmlcov/
.pytest_cache/
.tox/
.mypy_cache/
.ruff_cache/
