# Local development values (safe defaults for local-only use)
# Do not reuse these placeholders in staging or production.

# Frontend
# LAN / phone testing (geolocation needs HTTPS outside localhost):
#   1. VITE_DEV_HTTPS=true  (default) — Vite uses a temporary self-signed cert
#   2. VITE_API_BASE_URL=/api  — same-origin; Vite proxies to Django (avoids mixed content)
#   3. FRONTEND_URL=https://YOUR_LAN_IP:5173
#   4. CSRF_TRUSTED_ORIGINS must include https://YOUR_LAN_IP:5173
#   5. On the phone open https://YOUR_LAN_IP:5173 and accept the cert warning once
#   6. API: python manage.py runserver 0.0.0.0:8000   UI: npm run dev
# To force plain HTTP locally: VITE_DEV_HTTPS=false
VITE_DEV_HTTPS=true
VITE_DEV_SSL_DOMAINS=localhost,127.0.0.1,YOUR_LAN_IP
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
VITE_ALLOWED_HOSTS=.ngrok-free.app,.ngrok-free.dev,.ngrok.app,.ngrok.dev
VITE_API_BASE_URL=/api
# Optional mobile-data failure fallback shown after an SOS submission error.
# Use an emergency operations number controlled by your deployment.
VITE_EMERGENCY_SMS_NUMBER=

# Backend placeholders for the planned Django API
DJANGO_SECRET_KEY=change-me-local-only
DEBUG=true
# Include your LAN IP (or *) so phones can hit the API by host header.
ALLOWED_HOSTS=localhost,127.0.0.1

DB_ENGINE=django.contrib.gis.db.backends.postgis
DB_NAME=e_boses
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Shared Django cache backend (defaults to REDIS_URL). One Redis means the API
# server, Celery worker and beat see the same cache keys, so a beat task that
# clears a key is picked up by web requests immediately.
CACHE_REDIS_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
CELERY_TASK_TIME_LIMIT=180
CELERY_TASK_SOFT_TIME_LIMIT=120
JWT_SIGNING_KEY=change-me-local-only
FRONTEND_URL=https://localhost:5173
# Comma-separated; include https://YOUR_LAN_IP:5173 when testing on phones
# CSRF_TRUSTED_ORIGINS=https://localhost:5173,https://127.0.0.1:5173,https://localhost:5174,https://127.0.0.1:5174,https://YOUR_LAN_IP:5173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Local HTTPS tunnels are trusted by default in local mode; override if needed.
LOCAL_HTTPS_TUNNEL_ORIGINS=https://*.ngrok-free.app,https://*.ngrok-free.dev,https://*.ngrok.app,https://*.ngrok.dev
DJANGO_ENV=local

# -- Email ---------------------------------------------------------------------
# Verification codes (signup, password reset, change email) go through Resend.
#   development = print the code to the console, send nothing
#   resend      = send the branded HTML email
#   django_email = fall back to SMTP (requires EMAIL_BACKEND=smtp + EMAIL_HOST_*
#                  below; without SMTP it refuses to run outside local dev)
EMAIL_OTP_PROVIDER=development

# Get a key at resend.com/api-keys. Never commit a real one.
RESEND_API_KEY=
# onboarding@resend.dev only reaches the Resend account owner. For real
# residents, verify a domain at resend.com/domains and use an address on it.
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=E-Boses
RESEND_REPLY_TO=
# How long an email OTP waits for Resend's delivered/bounced event before
# treating the send as failed. 0 sends without waiting.
RESEND_DELIVERY_TIMEOUT_SECONDS=20
# HMAC secret for Resend inbound event webhooks (apps/service_status.py).
# Leave blank until you configure a webhook in the Resend dashboard.
RESEND_WEBHOOK_SECRET=
ACCOUNT_EMAIL_PROVIDER=disabled
SUPPORT_EMAIL=
# Shown as "E-Boses Support - Website" in /api/docs/ and the OpenAPI info block.
EBoses_WEBSITE_URL=

# SMTP wiring. console prints mail to stdout (local development); set "smtp"
# plus EMAIL_HOST_* to actually send through your provider.
EMAIL_BACKEND=console
DEFAULT_FROM_EMAIL=no-reply@e-boses.local
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
# Seconds before a stalled SMTP server gives up the send thread.
EMAIL_TIMEOUT=10

# ---------------------------------------------------------------------------
# SMS Gateway for Android (https://docs.sms-gate.app)
# ---------------------------------------------------------------------------
# An Android handset with the SMS Gateway app installed sends every SMS using
# its own SIM. No carrier approval and no per-subscriber consent: any Philippine
# network the SIM can text is reachable.
#
# Cloud mode (default) - the handset connects out to sms-gate.app, so Django
# needs no inbound network access to the phone:
#   1. Install the app, toggle "Cloud Server", tap Offline to connect.
#   2. Copy the username and password shown under Cloud Server.
#   SMS_GATE_BASE_URL=https://api.sms-gate.app
#
# Local mode - phone and Django on the same LAN, nothing leaves the premises:
#   1. Toggle "Local Server" in the app, tap Offline to start it (port 8080).
#   2. Copy the username/password and the device's local IP.
#   SMS_GATE_BASE_URL=http://<device-lan-ip>:8080
#
SMS_GATE_BASE_URL=https://api.sms-gate.app
SMS_GATE_USERNAME=
SMS_GATE_PASSWORD=
# Which SIM to send from on a dual-SIM handset (1-3). Blank uses the device default.
SMS_GATE_SIM_NUMBER=
SMS_GATE_TIMEOUT_SECONDS=30
# Prints instead of sending. Defaults on in local development and is forced on
# during test runs.
SMS_GATE_DRY_RUN=true
#
# Inbound SMS (two-way commands). Register with:
#   python manage.py register_sms_webhook --url https://<host>/api/sms/webhook/
# The app requires HTTPS; only http://127.0.0.1 may use plain HTTP. Copy the
# signing key from the app's webhook settings - without it every inbound
# request is rejected, because the view verifies an HMAC-SHA256 X-Signature.
SMS_GATE_WEBHOOK_SIGNING_KEY=
# Signed webhook timestamps older than this are rejected (anti-replay).
SMS_WEBHOOK_SIGNATURE_MAX_AGE_SECONDS=300
# SIM slot used for OTP/broadcast sends on dual-SIM handsets (1-3).
OUTBOUND_SMS_SIM_SLOT=
# Seconds the API waits on the handset's send endpoint before giving up.
OUTBOUND_SMS_TIMEOUT_SECONDS=30
# Tighter deadline for OTP texts so a stalled gateway cannot hang signup.
SMS_OTP_TIMEOUT_SECONDS=10


# SMS AI assist — best-effort rescue of messages the parser cannot read
# (typos, natural Filipino, landmark-only locations). Purely additive: if it
# is off, slow or wrong, SMS behaves exactly as it does without it.
SMS_AI_ASSIST_ENABLED=false
SMS_AI_TIMEOUT_SECONDS=8
SMS_AI_MIN_CONFIDENCE=0.75
SMS_INBOUND_PENDING_RECOVERY_SECONDS=60
SMS_INBOUND_PENDING_MAX_AGE_HOURS=24

# IP intelligence — fail-open gate on login, concern filing and emergency
# alerts (IPLogs-style service). Leave IP_INTEL_URL empty to disable.
# Point it at scripts/mock_iplogs.py during local development.
IP_INTEL_URL=
IP_INTEL_TIMEOUT_SECONDS=2.5
IP_INTEL_TRUSTED_PROXIES=127.0.0.1
# ASNs trusted even when the provider flags them (PLDT, Globe, DITO, Starlink PH).
IP_INTEL_ALLOWED_ASNS=AS9299,AS4775,AS139831,AS14593

# Reverse geocoding calls Nominatim; off automatically during test runs.
REVERSE_GEOCODE_ENABLED=true

# Daily housekeeping prunes background GPS pings older than this many days
# (see apps.emergencies.tasks.periodic_housekeeping_task).
LOCATION_PING_RETENTION_DAYS=30
# Audit-trail rows older than this many days are pruned by the same task.
AUDIT_LOG_RETENTION_DAYS=180

WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:no-reply@e-boses.local

MEDIA_URL=/media/
MEDIA_ROOT=media/
# Sensitive uploads are stored privately and should not be served directly by the web server.
PRIVATE_MEDIA_ROOT=private_media/

# Upload guards
# Cap for the non-file form payload; per-file limits live in upload validators.
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=10485760
# Recency bound on photo-duplicate candidate lookups. 0 (default) compares
# against full upload history. Only raise if duplicate checks ever get slow.
MEDIA_DEDUP_WINDOW_DAYS=0

# Optional external integrations
OCRSPACE_API_KEY=
OCRSPACE_URL=https://api.ocr.space/parse/image
OCRSPACE_ENGINE=2
OCRSPACE_LANGUAGE=auto
OCRSPACE_OVERLAY=true
OCRSPACE_CONNECT_TIMEOUT=10
OCRSPACE_READ_TIMEOUT=60
OCRSPACE_MAX_RETRIES=3
IP2GEO_API_KEY=
IP2GEO_API_URL=
# Gemma (Ollama Cloud) — reads report text and photos.
OLLAMA_API_KEY=
OLLAMA_HOST=https://ollama.com
OLLAMA_TEXT_MODEL=gemma4:31b
OLLAMA_TIMEOUT_SECONDS=120
# Tighter budget for the resident-facing precheck text call.
OLLAMA_PRECHECK_TEXT_TIMEOUT_SECONDS=8
OLLAMA_ENABLE_IMAGE_ANALYSIS=true
# Image requests get their own budget: they carry a much larger payload than
# text and are the ones that time out on a slow uplink.
OLLAMA_IMAGE_TIMEOUT_SECONDS=90
OLLAMA_IMAGE_RETRY_DELAY_SECONDS=2
# Ollama Cloud 500s intermittently on image requests; attempts back off 2s/4s/8s.
OLLAMA_IMAGE_MAX_ATTEMPTS=3
# Tiny images are refused by the vision encoder; they are upscaled to this first.
OLLAMA_IMAGE_MIN_SIDE=512
OLLAMA_IMAGE_MAX_SIDE=1024
OLLAMA_IMAGE_JPEG_QUALITY=82
OLLAMA_IMAGE_MAX_BYTES=0

# E-Boses Assistant (public chatbot) — Poolside-hosted inference.
ASSISTANT_ENABLED=true
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://inference.poolside.ai/v1
ASSISTANT_MODEL=poolside/laguna-xs-2.1
ASSISTANT_TIMEOUT_SECONDS=30
ASSISTANT_MAX_TOKENS=220
# Rolling per-session budget window in seconds.
ASSISTANT_SESSION_BUDGET_WINDOW_SECONDS=600

# SAM3 privacy segmentation (Roboflow serverless). Runs only when Gemma asks
# for a privacy scan. Placeholder only — never commit a real key.
ROBOFLOW_API_KEY=replace-with-rotated-key
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_WORKSPACE=eboses-north
ROBOFLOW_WORKFLOW_ID=general-segmentation-api-3
ROBOFLOW_TIMEOUT_SECONDS=60

# OpenCV redaction applied to SAM3 masks and official manual blur boxes.
EBOSES_PRIVACY_BLUR_STRENGTH=31
EBOSES_PRIVACY_MASK_PADDING=0.12

# Production-required secrets and hardening checklist
# - Set DEBUG=false and provide a unique high-entropy DJANGO_SECRET_KEY.
# - Set ALLOWED_HOSTS to exact production hostnames.
# - Use strong DB_PASSWORD, REDIS_URL credentials, and non-console EMAIL/SMS providers
#   (EMAIL_BACKEND=smtp + EMAIL_HOST_*, and a live OUTBOUND_SMS driver).
# - Configure WEB_PUSH_PUBLIC_KEY and WEB_PUSH_PRIVATE_KEY for browser notifications.
# - Configure OLLAMA_API_KEY for report review through Ollama Cloud.
# - Configure ROBOFLOW_API_KEY for automatic media protection. Without it, photos
#   the review flags as possibly sensitive stay restricted pending manual review.
# - Run: python apps/api/manage.py check_production_readiness --strict
# - Keep PRIVATE_MEDIA_ROOT outside any public static/media directory and serve files only through authorized views.
# - Rotate any value that was ever committed, logged, or shared outside the target environment.

# --- Runtime headers & logging ----------------------------------------------
# Trust X-Forwarded-Proto from your proxy for secure-cookie/HSTS decisions.
TRUST_X_FORWARDED_PROTO=
# Full CSP/Permissions-Policy header values; blank uses safe built-in defaults.
CONTENT_SECURITY_POLICY=
PERMISSIONS_POLICY=
LOG_LEVEL=INFO
# Requests slower than this get a WARNING log line (method, path, duration).
SLOW_REQUEST_LOG_MS=500
# GET /api/health/?deep=1 probes cache/Redis/email/AI/SMS providers with a
# 2.5s timeout each and caches results for 30s. Keep monitoring polls gentle.

# --- Media storage -----------------------------------------------------------
# Leave blank to keep uploads on local disk (they do NOT survive a redeploy on
# Render/Railway/Fly). Set it and uploads go to Cloudinary instead.
# Copy the whole line from Cloudinary console > Dashboard > API Environment
# variable. Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Signed-URL lifetime for server-side reads of private assets.
CLOUDINARY_PRIVATE_URL_TTL_SECONDS=300
# Raw government ID images are deleted this long after verification settles.
# Duplicate and ID-reuse detection are unaffected: those hashes are DB columns.
ID_IMAGE_RETENTION_DAYS=30
# A verification case still queued/processing after this many minutes has lost
# its worker and is rescued (or parked for an official) by the sweeper.
OCR_STUCK_CASE_MINUTES=15
# Residents download their own data without an official approving it.
SELF_SERVICE_DATA_EXPORT=true

# --- Complete runtime contract ----------------------------------------------
DATABASE_URL=
ENABLE_GIS=false
LOCAL_DATABASE_URL=
STORAGE_BACKEND=local
EBOSES_E2E_PASSWORD=
ACCOUNT_DELETION_GRACE_DAYS=30
ASSISTANT_SESSION_BUDGET=8
CELERY_RESULT_EXPIRES=21600
CELERY_TASK_DEFAULT_QUEUE=eboses
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_REGEXES=
CSRF_TRUSTED_ORIGINS=
CSRF_COOKIE_HTTPONLY=false
CSRF_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false
REFRESH_COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
IP_INTEL_PROVIDER=disabled
IP_INTEL_API_KEY=
IP_INTEL_CACHE_SECONDS=900
IP_INTEL_MIN_TRUST_SCORE=0
TRUSTED_PROXY_IPS=
OCR_LIVE_TESTS=false
OTP_EMAIL_EXPIRY_TEXT=5 minutes
OTP_EMAIL_LOGO_URL=
OSM_ROUTE_URL=https://router.project-osrm.org/route/v1/driving
OSM_ROUTE_TIMEOUT_SECONDS=8
VITE_CARTO_BASEMAP_KEY=
SMS_GATEWAY_NUMBER=
SMS_OTP_PROVIDER=development
SMS_OTP_WEBHOOK_URL=
SMS_OTP_WEBHOOK_TOKEN=
SMS_EMERGENCY_WEBHOOK_TOKEN=
SMS_INBOUND_WEBHOOK_TOKEN=
SMS_WEBHOOK_SIGNING_KEY=
SMS_WEBHOOK_DEBUG=false
OUTBOUND_SMS_DRIVER=console
OUTBOUND_SMS_URL=
OUTBOUND_SMS_METHOD=POST
OUTBOUND_SMS_USERNAME=
OUTBOUND_SMS_PASSWORD=
OUTBOUND_SMS_AUTH_HEADER=
OUTBOUND_SMS_SECRET=
OUTBOUND_SMS_SIGN_KEY=
OUTBOUND_SMS_EXTRA_HEADERS=
OUTBOUND_SMS_PAYLOAD_TEMPLATE=
RESEND_API_URL=https://api.resend.com/emails
